{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "blue",
      "2": "magenta"
    }
  },
  "display": {
    "separator": "  ➜  ",
    "color": {
      "keys": "blue",
      "title": "magenta"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "  {user-name} @ FusionOS"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "  SO",
      "format": "FusionOS 1.0 Noble (x86_64)"
    },
    {
      "type": "kernel",
      "key": "  Kernel"
    },
    {
      "type": "uptime",
      "key": "  Tempo Ativo"
    },
    {
      "type": "packages",
      "key": "  Pacotes"
    },
    {
      "type": "de",
      "key": "  Ambiente",
      "format": "KDE Plasma 6 (Wayland)"
    },
    {
      "type": "terminal",
      "key": "  Terminal"
    },
    {
      "type": "cpu",
      "key": "  Processador"
    },
    {
      "type": "gpu",
      "key": "  Placa de Video"
    },
    {
      "type": "memory",
      "key": "  Memoria RAM"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
