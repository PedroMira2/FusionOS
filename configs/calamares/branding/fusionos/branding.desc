# ==============================================================================
# FusionOS Calamares Branding Specification
# Proposito: Define identidade visual, cores e estilo da instalação do sistema
# ==============================================================================
---
componentName: fusionos

welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: noexpand
windowSize: 960px, 620px
windowPlacement: center

strings:
    productName:         "FusionOS"
    shortProductName:    "FusionOS"
    version:             "1.0 (Noble)"
    shortVersion:        "1.0"
    versionedName:       "FusionOS 1.0 Noble"
    shortVersionedName:  "FusionOS 1.0"
    bootloaderEntryName: "FusionOS"
    productUrl:          "https://github.com/PedroMira2/FusionOS"
    supportUrl:          "https://github.com/PedroMira2/FusionOS/issues"
    knownIssuesUrl:      "https://github.com/PedroMira2/FusionOS/issues"
    releaseNotesUrl:     "https://github.com/PedroMira2/FusionOS/releases"

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow:               "slideshow.qml"

style:
   SidebarBackground:    "#0D0F1A"
   SidebarText:          "#9CA3AF"
   SidebarTextSelect:    "#5B8BFF"
   SidebarTextHighlight: "#E8ECF5"
